# Required: MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartshop?retryWrites=true&w=majority
DB_NAME=smartshop

# Optional: port mapping (default 8501)
# PORT=8501

# Optional: override admin credentials (defaults: admin / admin)
# ADMIN_USER=admin
# ADMIN_PASS=your_secure_password
